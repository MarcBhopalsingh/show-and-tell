---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (async () => {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, category, tags, date, link, repo } = project.data;

const categoryLabels: Record<string, string> = {
	software: "Software",
	pi: "Raspberry Pi",
	automation: "Automation",
};

const formattedDate = date.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
});
---

<Layout title={title} description={summary}>
	<article class="container article">
		<a href="/projects" class="back">&larr; Projects</a>
		<header class="head">
			<p class="eyebrow">{categoryLabels[category] ?? category}</p>
			<h1>{title}</h1>
			<p class="summary muted">{summary}</p>
			<div class="meta">
				<time datetime={date.toISOString()}>{formattedDate}</time>
				{link && <a href={link}>Live &rarr;</a>}
				{repo && <a href={repo}>Source &rarr;</a>}
			</div>
			{
				tags.length > 0 && (
					<ul class="tags">
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.article {
		max-width: var(--measure);
		padding-block: var(--space-12) var(--space-8);
	}

	.back {
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.head {
		margin-block: var(--space-6) var(--space-8);
		padding-bottom: var(--space-8);
		border-bottom: 1px solid var(--color-border);
	}

	.head h1 {
		margin-top: var(--space-3);
	}

	.summary {
		font-size: var(--text-lg);
		margin-top: var(--space-4);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-6);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.meta a {
		font-weight: 600;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		padding: 0;
		margin-top: var(--space-4);
	}

	.tags li {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		background: var(--color-surface);
		padding: 0.2em 0.6em;
		border-radius: 999px;
	}
</style>

<style is:global>
	.prose > * + * {
		margin-top: var(--space-4);
	}

	.prose h2 {
		font-size: var(--text-2xl);
		margin-top: var(--space-12);
	}

	.prose h3 {
		font-size: var(--text-xl);
		margin-top: var(--space-8);
	}

	.prose ul,
	.prose ol {
		padding-left: var(--space-6);
	}

	.prose li + li {
		margin-top: var(--space-2);
	}
</style>
