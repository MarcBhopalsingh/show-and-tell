# Site identity — copy this file to `.env` and fill in your real values.
# `.env` is gitignored, so your personal info never enters the repo/history.
# If a variable is omitted, the placeholder default in astro.config.mjs is used.

SITE_AUTHOR="Your Name"
SITE_DESCRIPTION="Software projects, hardware builds, automations, and writing."
SITE_EMAIL="you@example.com"
SITE_GITHUB="https://github.com/yourusername"
SITE_LINKEDIN="https://www.linkedin.com/in/yourusername/"
